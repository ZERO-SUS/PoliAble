# ==============================================================================
# PoliAble — .gitignore
# ==============================================================================

# Build Output Directories
out/
build/
bin/
dist/

# Visual Studio & IDE Caches
.vs/
.vscode/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.suo
*.user

# CMake Caches & Generated Files
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Testing/
Makefile
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps/
*.cache*
*?PoliAble*

# Compiled Objects & Libraries
*.obj
*.o
*.slo
*.lo
*.lib
*.a
*.la
*.lai

# Executables & Debug Artifacts
*.exe
*.dll
*.so
*.dylib
*.pdb
*.ilk
*.exp

# Qt Generated MOC / RCC / UIC files
*.moc
moc_*.cpp
qrc_*.cpp
ui_*.h
PoliAble_autogen/

# vcpkg Package Manager
vcpkg_installed/

# OS Specific
Thumbs.db
Desktop.ini
.DS_Store

# Temporary & Log files
*.log
*.tmp
*.bak
*.swp

# Secrets & Environment Variables (Safety Guard)
.env
.env.*
!.env.example
*.key
*.pem
*.cert
*.pfx
